# ===== Entorno de prueba compartible (VS Code Ports) =====
# Copia a .env.tunnel y completa. scripts\demo.ps1 carga este archivo.
DJANGO_SETTINGS_MODULE=config.settings.tunnel
SECRET_KEY=cambia-esta-clave-para-la-demo
# URL pública del túnel (paso 6 del README), p. ej. https://abcd1234-8000.use2.devtunnels.ms
SITE_URL=
# PostgreSQL local recomendado (búsqueda igual que producción). Vacío = SQLite.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/globaltec
MEDIA_ROOT=
ADMIN_URL=gestion-tecnica-gt/

# Wompi SANDBOX (nunca llaves de producción en el túnel)
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxx
WOMPI_ENV=sandbox

# Email: vacío = se imprime en la consola del script
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
ADMIN_NOTIFY_EMAIL=
