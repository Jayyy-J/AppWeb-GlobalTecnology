# ===== GlobalTecnology · variables de entorno =====
# Copia este archivo a .env (desarrollo) o configúralas en Railway (producción).

# Django
SECRET_KEY=cambia-esta-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=tudominio.com,www.tudominio.com
CSRF_TRUSTED_ORIGINS=https://tudominio.com,https://www.tudominio.com
SITE_URL=https://tudominio.com
# Ruta no obvia del Django admin (respaldo técnico)
ADMIN_URL=gestion-tecnica-gt/

# Base de datos (Railway la inyecta con el plugin PostgreSQL). Sin ella se usa SQLite.
DATABASE_URL=postgres://usuario:clave@localhost:5432/globaltec

# Archivos subidos (en Railway: volumen montado en /app/media)
MEDIA_ROOT=/app/media

# Wompi (sandbox: pub_test_/prv_test_; producción: pub_prod_/prv_prod_)
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxx
WOMPI_ENV=sandbox

# Email (SMTP). Sin EMAIL_BACKEND se usa la consola.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=ventas@tudominio.com
EMAIL_HOST_PASSWORD=clave-de-aplicacion
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=GlobalTecnology <ventas@tudominio.com>
# Recibe los avisos de pedidos pagados y por cotizar
ADMIN_NOTIFY_EMAIL=admin@tudominio.com
